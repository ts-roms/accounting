{
  "name": "@accounting/types",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../tsconfig/esm-marker.mjs && tsc -p tsconfig.build.json && tsc -p tsconfig.esm.json",
    "dev": "node ../tsconfig/esm-marker.mjs && tsc -b tsconfig.build.json tsconfig.esm.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@accounting/eslint-config": "workspace:*",
    "@accounting/tsconfig": "workspace:*",
    "eslint": "^9.34.0",
    "typescript": "~5.9.3"
  },
  "files": [
    "dist"
  ],
  "module": "./dist/esm/index.js",
  "sideEffects": false
}
