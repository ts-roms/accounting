{
  "name": "@accounting/validation",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@accounting/types": "workspace:*",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@accounting/eslint-config": "workspace:*",
    "@accounting/tsconfig": "workspace:*",
    "eslint": "^9.34.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist"
  ]
}
