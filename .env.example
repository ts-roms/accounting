# ---------------------------------------------------------------------------
# Shared environment (copy to .env). Never commit real secrets.
# ---------------------------------------------------------------------------
NODE_ENV=development

# --- API (NestJS) ----------------------------------------------------------
API_PORT=3001
API_HOST=0.0.0.0
API_GLOBAL_PREFIX=api
API_CORS_ORIGINS=http://localhost:3006

# PostgreSQL (docker-compose maps container 5432 -> host 5433 to avoid clashing
# with a locally installed PostgreSQL).
DATABASE_URL=postgres://accounting:accounting@localhost:5433/accounting
DATABASE_POOL_MAX=10
# Optional: separate DB used by API integration tests. Git worktrees automatically get
# their own database (accounting_test_<worktree>); set TEST_DATABASE_SUFFIX to isolate
# any other checkout. Missing databases are created by the e2e global setup.
TEST_DATABASE_URL=postgres://accounting:accounting@localhost:5433/accounting_test
# TEST_DATABASE_SUFFIX=

# Redis
REDIS_URL=redis://localhost:6379

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Rate limiting
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120

# Logging
LOG_LEVEL=debug

# Seed data (development only)
SEED_ADMIN_EMAIL=admin@acme.local
SEED_ADMIN_PASSWORD=P@ssw0rd123
SEED_DEMO_PASSWORD=P@ssw0rd123
# Per-request authorization context cache (ms); 0 disables. Sessions are always checked live.
AUTHZ_CACHE_TTL_MS=30000

# --- Web (Next.js) ---------------------------------------------------------
# Server-side only: where Next.js proxies /api/* requests.
API_INTERNAL_URL=http://localhost:3001
WEB_PORT=3006

# Attachment storage (Phase 8)
STORAGE_DIR=./storage

# AI assistance (Phase 9) - advisory only. HEURISTIC works offline; ANTHROPIC needs a key.
AI_PROVIDER=HEURISTIC
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_ANOMALY_SCAN_DAYS=7

# ---------------------------------------------------------------------------
# Integration platform (Prompt #4)
# ---------------------------------------------------------------------------
# Encrypts provider credentials, OAuth tokens and webhook secrets at rest.
# Required in production: 32 bytes as hex/base64, or a long passphrase.
INTEGRATION_ENCRYPTION_KEY=change-me-integration-encryption-key-please
# Run sync / webhook jobs inline instead of BullMQ (tests and Redis-less dev).
INTEGRATION_INLINE_JOBS=false
# Operations (H8): nightly integrity check cron (empty disables), BullMQ key prefix
# (one per deployment / dev checkout sharing a Redis), optional bearer token for GET /metrics.
INTEGRITY_CHECK_CRON=45 3 * * *
QUEUE_PREFIX=accounting
# METRICS_TOKEN=
WEBHOOK_TIMEOUT_MS=10000
# Retention in days for the nightly integration cleanup (dead letters are kept twice as long)
INTEGRATION_LOG_RETENTION_DAYS=90
INTEGRATION_EVENT_RETENTION_DAYS=30
WEBHOOK_DELIVERY_RETENTION_DAYS=30
SYNC_JOB_RETENTION_DAYS=180
# Public API base URL used to build OAuth redirect URIs (defaults to the web origin + /api/v1).
# OAUTH_REDIRECT_BASE_URL=https://api.example.com
WEB_BASE_URL=http://localhost:3006
