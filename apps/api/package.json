{
  "name": "@accounting/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS backend - modular monolith for the accounting platform",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config test/jest-e2e.config.ts --runInBand",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed/index.ts",
    "db:reset": "tsx src/database/reset.ts",
    "db:studio": "drizzle-kit studio",
    "db:migrate:dist": "node dist/database/migrate.js"
  },
  "dependencies": {
    "@accounting/config": "workspace:*",
    "@accounting/money": "workspace:*",
    "@accounting/types": "workspace:*",
    "@accounting/validation": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.58.0",
    "cookie-parser": "^1.4.7",
    "cron-parser": "4.9.0",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.45.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "nestjs-pino": "^4.4.0",
    "nestjs-zod": "^5.0.0",
    "pdf-parse": "1.1.1",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@accounting/eslint-config": "workspace:*",
    "@accounting/tsconfig": "workspace:*",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.18.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.34.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3"
  }
}
