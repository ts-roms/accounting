{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@accounting/web", "dev"],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@accounting/api", "dev"],
      "port": 3001
    },
    {
      "name": "api-verify",
      "runtimeExecutable": "node",
      "runtimeArgs": ["apps/api/dist/main.js"],
      "port": 3011,
      "env": {
        "API_PORT": "3011",
        "ACCOUNTING_SCHEDULES_CRON": ""
      }
    },
    {
      "name": "web-verify",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@accounting/web",
        "exec",
        "next",
        "dev",
        "--turbopack",
        "-p",
        "3010"
      ],
      "port": 3010,
      "env": {
        "API_INTERNAL_URL": "http://localhost:3011",
        "NEXT_DIST_DIR": ".next-verify"
      }
    },
    {
      "name": "web-ar",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@accounting/web",
        "exec",
        "next",
        "dev",
        "--turbopack",
        "-p",
        "3021"
      ],
      "port": 3021,
      "env": {
        "API_INTERNAL_URL": "http://localhost:3012"
      }
    }
  ]
}
